{
  "name": "sticky-do-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "build:extension": "tsc -b && vite build --mode extension",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "test": "node scripts/gen-tokens.ts --check && vitest run",
    "gen:tokens": "node scripts/gen-tokens.ts"
  },
  "dependencies": {
    "@stickydo/core": "*",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-list": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/markdown": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "cmdk": "^1.1.1",
    "dexie": "^4.4.6",
    "motion": "^13.4.6",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-rnd": "^10.5.3",
    "react-router": "^8.4.0",
    "sonner": "^2.0.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/vite": "^4.3.3",
